# ScenarioChef local environment template.
# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# --- C2 LLM proposer (OpenAI-compatible endpoint; defaults to the Laguna
# --- model via command code, see src/scenariochef/c2_understanding/runtime.py).
# Required to enable the real-LLM C2 path; unset keeps the offline null proposer.
C2_LLM_API_KEY=<your-key>
C2_LLM_MODEL=poolside/laguna-s-2.1-free
C2_LLM_BASE_URL=https://api.commandcode.ai/provider/v1/

# --- C7 esmini runner ---
# Path to the esmini executable; without it C7 returns skipped_no_binary.
ESMINI_BIN=/absolute/path/to/esmini
# esmini build id recorded in RunConfig (informational).
ESMINI_BUILD=esmini-3.7.2

# Optional overrides (defaults shown):
# ESMINI_ASSET_PATH=<repo-root>
# ESMINI_BUILD=
