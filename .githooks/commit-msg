#!/bin/sh
# Strip Co-authored-by trailers that attribute Cursor from commit messages.
# Installed via scripts/install-git-hooks.sh

msg_file="$1"

if [ ! -f "$msg_file" ]; then
  exit 0
fi

tmp="${msg_file}.sc-clean"
grep -viE '^[[:space:]]*co-authored-by:[[:space:]]*.*cursor' "$msg_file" >"$tmp"
mv "$tmp" "$msg_file"

exit 0
